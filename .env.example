# Copy this file to .env and fill in real values.
# .env is git-ignored and must never be committed.

JARVIS_ENVIRONMENT=development
JARVIS_HOST=0.0.0.0
JARVIS_PORT=8000

# Gemini API key - get one at https://aistudio.google.com/apikey
JARVIS_GEMINI_API_KEY=YOUR_GEMINI_API_KEY_HERE
JARVIS_GEMINI_MODEL=gemini-3.8-flash

# Additional AI providers (M11 foundation, see README's "Multi-Provider AI
# Foundation" section) - Groq, OpenRouter, and Cloudflare Workers AI,
# deliberately the only three besides Gemini for now. Each is independent
# and optional. Leaving a provider's key blank just means that provider
# isn't "configured" (see app/providers/factory.py:describe_providers);
# Jarvis itself still runs fine and Core still uses Gemini alone - there's
# no provider selection/fallback yet, this milestone only adds the
# adapters.
# Groq - get a key at https://console.groq.com/keys
JARVIS_GROQ_API_KEY=YOUR_GROQ_API_KEY_HERE
JARVIS_GROQ_MODEL=openai/gpt-oss-120b

# OpenRouter - get a key at https://openrouter.ai/keys
JARVIS_OPENROUTER_API_KEY=YOUR_OPENROUTER_API_KEY_HERE
JARVIS_OPENROUTER_MODEL=openrouter/auto

# Cloudflare Workers AI - API token + account id from
# https://dash.cloudflare.com/ (My Profile -> API Tokens; Account Home for
# the account id). Both are required together - the API URL is per-account.
JARVIS_CLOUDFLARE_API_KEY=YOUR_CLOUDFLARE_API_KEY_HERE
JARVIS_CLOUDFLARE_ACCOUNT_ID=YOUR_CLOUDFLARE_ACCOUNT_ID_HERE
JARVIS_CLOUDFLARE_MODEL=@cf/meta/llama-3.1-8b-instruct

# FreeLLMAPI - a self-hosted, OpenAI-compatible AI gateway
# (https://github.com/tashfeenahmed/freellmapi) you run locally, e.g. via
# Docker Compose. Setting the key below is the ONLY step needed to enable
# it: app/providers/factory.py automatically adds it as the final fallback
# provider, after everything above, even though it's not listed in
# JARVIS_AI_PROVIDER_ORDER below - no second edit needed there. Leave the
# key blank to leave FreeLLMAPI disabled entirely. The key is FreeLLMAPI's
# own "unified" key from its Dashboard -> Keys page - NOT any individual
# provider key FreeLLMAPI holds internally. The base URL below only needs
# changing if FreeLLMAPI isn't running at the default local address.
JARVIS_FREELLMAPI_API_KEY=YOUR_FREELLMAPI_UNIFIED_KEY_HERE
JARVIS_FREELLMAPI_BASE_URL=http://localhost:3001/v1

# AI provider manager (M12, see README's "AI Provider Manager + Fallback"
# section) - ordered, comma-separated list of the providers above to try,
# with automatic fallback/retry/cooldown on failure. A name left out of this
# list is effectively disabled. OpenRouter is only ever called with the
# model configured above - the manager never selects or purchases a paid
# model on its own. (FreeLLMAPI is deliberately not listed here - see the
# comment above JARVIS_FREELLMAPI_API_KEY.)
JARVIS_AI_PROVIDER_ORDER=gemini,groq,openrouter,cloudflare
JARVIS_AI_PROVIDER_RETRY_COUNT=2
JARVIS_AI_PROVIDER_RETRY_DELAY_SECONDS=0.5
JARVIS_AI_PROVIDER_COOLDOWN_SECONDS=60

# Memory - local SQLite file for conversation history and user facts
JARVIS_MEMORY_DB_PATH=jarvis_memory.db

# SearXNG - base URL of a running SearXNG instance, used by the web_search
# tool. No public default; point this at your own instance.
JARVIS_SEARXNG_URL=

# Ordered, comma-separated list of search providers to try for web_search,
# with automatic fallback to the next on failure. Only "searxng" is
# implemented so far; more (brave, tavily, ...) can be appended later.
JARVIS_SEARCH_PROVIDER_ORDER=searxng

# Search result cache (SQLite-backed) - how long cached web_search results
# stay valid, in seconds, and the local file they're stored in. Expired
# entries are treated as cache misses, not errors.
JARVIS_SEARCH_CACHE_TTL=600
JARVIS_SEARCH_CACHE_DB_PATH=jarvis_search_cache.db

# Reminders - local SQLite file for persistent tasks/reminders, and how
# often the background scheduler polls for due ones, in seconds.
JARVIS_REMINDERS_DB_PATH=jarvis_reminders.db
JARVIS_REMINDER_POLL_INTERVAL_SECONDS=30

# Automations - local SQLite file for the persistent automation engine,
# and how often it polls for due automations, in seconds.
JARVIS_AUTOMATIONS_DB_PATH=jarvis_automations.db
JARVIS_AUTOMATION_POLL_INTERVAL_SECONDS=30

# Google Calendar - client_id/client_secret from a Google Cloud "Desktop
# app" OAuth client (console.cloud.google.com -> APIs & Services ->
# Credentials). Leave blank to leave the calendar tools unauthorized
# (they'll fail gracefully with a clear error). After setting these, run
# `python -m app.calendar.authorize` once to grant access - the resulting
# refresh token is stored locally (JARVIS_CALENDAR_TOKEN_DB_PATH) and
# auto-refreshed after that; never commit that file.
JARVIS_GOOGLE_CLIENT_ID=
JARVIS_GOOGLE_CLIENT_SECRET=
JARVIS_GOOGLE_OAUTH_REDIRECT_PORT=8765
JARVIS_CALENDAR_ID=primary
JARVIS_CALENDAR_TOKEN_DB_PATH=jarvis_calendar_token.db

# Jarvis Tasks - local SQLite file for local, independent todo items (not
# synced anywhere, not scheduled/notified - see Reminders above for that).
JARVIS_TASKS_DB_PATH=jarvis_tasks.db

# Orchestration (M15) - goal-driven Jobs: plan -> validate -> execute
# through the existing tool system, see app/orchestration/. Needs no
# setup beyond these defaults; safety limits keep a plan/replan chain
# bounded regardless of what the planner proposes.
JARVIS_ORCHESTRATION_DB_PATH=jarvis_orchestration.db
JARVIS_ORCHESTRATION_POLL_INTERVAL_SECONDS=15
JARVIS_ORCHESTRATION_MAX_STEPS=20
JARVIS_ORCHESTRATION_MAX_TOTAL_STEPS=40
JARVIS_ORCHESTRATION_MAX_RETRIES_PER_STEP=2
JARVIS_ORCHESTRATION_RETRY_DELAY_SECONDS=1
JARVIS_ORCHESTRATION_MAX_REPLANS=2
JARVIS_ORCHESTRATION_DEFAULT_AUTONOMY=assisted

# Voice (hands-free wake-word + STT + TTS - see app/voice/ and this
# repo's README's Voice Interface section). $0/fully local: openWakeWord
# for wake-word detection, Vosk for speech-to-text, Windows SAPI (built
# into Windows) for text-to-speech. Talks only to the /chat endpoint
# below - never imports Jarvis Core directly - so the regular server
# (`uvicorn app.main:app`) must already be running separately.
#
# TODO (you): before running `python -m app.voice.run`, you need to:
#   1. `pip install -r requirements.txt` (adds vosk/sounddevice/numpy/
#      openwakeword - all free, offline, no account needed).
#   2. Download the wake-word model: `python -m app.voice.download_wakeword_model`
#      (fetches openWakeWord's pretrained "hey_jarvis" model + its
#      required feature models from GitHub - a one-time, $0 file
#      download, not a runtime API). Then set
#      JARVIS_VOICE_WAKEWORD_MODEL_PATH to the path it prints.
#   3. Download a Vosk speech-to-text model from
#      https://alphacephei.com/vosk/models (e.g. the small English model,
#      ~40MB) and extract it somewhere. Then set
#      JARVIS_VOICE_VOSK_MODEL_PATH to that extracted folder.
#   4. (Optional) If you have more than one microphone, list devices with
#      `python -c "import sounddevice as sd; print(sd.query_devices())"`
#      and set JARVIS_VOICE_INPUT_DEVICE to the one you want (by name or
#      index) - leave blank to use the system default.
JARVIS_VOICE_CHAT_URL=http://127.0.0.1:8000
JARVIS_VOICE_CHAT_TIMEOUT_SECONDS=60
JARVIS_VOICE_WAKEWORD_MODEL_PATH=
JARVIS_VOICE_WAKEWORD_THRESHOLD=0.5
JARVIS_VOICE_VOSK_MODEL_PATH=
JARVIS_VOICE_INPUT_DEVICE=
JARVIS_VOICE_TTS_VOICE_NAME=
JARVIS_VOICE_TTS_RATE=0
JARVIS_VOICE_SILENCE_SECONDS=1.2
JARVIS_VOICE_MAX_UTTERANCE_SECONDS=15
JARVIS_VOICE_SPEECH_AMPLITUDE_THRESHOLD=500

# Scheduling (see app/scheduling/): the IANA time zone NEW schedules are created in, e.g. Europe/London (Region/City).
# Leave it empty to use the system's time zone - only when Jarvis can determine it reliably; otherwise creating a
# time-based schedule fails with a clear message rather than risk firing at the wrong time. Requires the `tzdata`
# package (in requirements.txt). A schedule keeps the zone it was created in even if you change this later.
JARVIS_TIMEZONE=
# How late (seconds) a due run may still simply run; later than this it counts as missed.
JARVIS_SCHEDULE_GRACE_SECONDS=600
# The shortest gap, in minutes, between runs of a NEW repeating schedule.
JARVIS_SCHEDULE_MIN_INTERVAL_MINUTES=15

# Computer Input Gate: whether Jarvis may send INPUT to the desktop (type_text, press_key, move_mouse, click_mouse, double_click, open_application).
# OFF unless you turn it on. The limit is ONE budget shared by all six, per rolling 60 seconds.
JARVIS_COMPUTER_INPUT_ENABLED=false
JARVIS_COMPUTER_INPUT_ACTIONS_PER_MINUTE=10

# Workspace Files: the ONE folder where Jarvis may list/read small text files and create NEW ones (never overwrite or delete).
# The folder is created on the first write. Set the switch to false to stop all workspace tools at once.
JARVIS_WORKSPACE_ENABLED=true
# JARVIS_WORKSPACE_DIR=C:\Users\you\Documents\Jarvis Workspace
JARVIS_WORKSPACE_MAX_FILE_BYTES=65536
JARVIS_WORKSPACE_MAX_FILES=200
JARVIS_WORKSPACE_MAX_TOTAL_BYTES=20971520
JARVIS_WORKSPACE_WRITES_PER_MINUTE=10

# Safe first run (Milestone 0). JARVIS_DATA_DIR puts every database, the device credential and the log in that folder instead of
# the current directory - e.g. JARVIS_DATA_DIR=sandbox for a disposable trial with empty databases. Empty = the usual place.
JARVIS_DATA_DIR=
# false = the server starts no background worker (reminders, automations, Jobs, scheduled runs): nothing runs on its own.
JARVIS_BACKGROUND_SCHEDULERS_ENABLED=true
# Log file (inside JARVIS_DATA_DIR when that is set); empty = console only. Levels: DEBUG, INFO, WARNING, ERROR.
JARVIS_LOG_FILE=jarvis.log
JARVIS_LOG_LEVEL=INFO
# Self-Development Engine: off unless turned on. Its approvals come through the anonymous /chat, so leave it off until that is authenticated.
JARVIS_SELF_DEV_ENABLED=false

# Future milestones will add more keys here.
