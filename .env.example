# Copy this file to .env and fill in real values.
# .env is git-ignored and must never be committed.

JARVIS_ENVIRONMENT=development
JARVIS_HOST=0.0.0.0
JARVIS_PORT=8000

# Gemini API key - get one at https://aistudio.google.com/apikey
JARVIS_GEMINI_API_KEY=
JARVIS_GEMINI_MODEL=gemini-3.8-flash

# Future milestones will add more keys here.
